if (data.success && data.downloadUrl) {
  // Use proxy to avoid Forbidden
  const proxyUrl = `https://vidvault-api.onrender.com/proxy-download?url=${encodeURIComponent(data.downloadUrl)}`;
  
  downloadBtn.href = proxyUrl;
  downloadBtn.target = "_blank";
  downloadBtn.setAttribute("download", `${displayTitle}.mkv`);
  downloadBtnText.innerText = "Download Video";
}